LOCAL_LLM_URL=http://gpu-server-01:11434
LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_LLM_TIMEOUT=90
# Default provider for analyse_job / extract_candidate / score (compensation stays local).
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT=90
OPENAI_TEMPERATURE=0.1
# USD per 1M tokens (defaults aligned to gpt-4.1). Table also embeds gpt-4.1-mini / gpt-4o-mini.
OPENAI_PRICE_INPUT_PER_1M=2.00
OPENAI_PRICE_OUTPUT_PER_1M=8.00
OLLAMA_BASE_URL=http://gpu-server-01:11434
OLLAMA_MODEL=qwen2.5:14b
SEARCH_ENGINES=tavily
ENABLED_CRAWLERS=glassdoor,indeed,vagas,generic
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Also editable as business parameters in UI /settings (data/business_settings.json).
# Prompt templates can reference {clt_to_pj_factor}, {work_hours_month}, {cache_ttl_days}, or {business_context}.
CLT_TO_PJ_FACTOR=1.50
WORK_HOURS_MONTH=168
MAX_PARALLEL_SEARCHES=4
MAX_PARALLEL_CRAWLS=5
# Fallback only when business param cache_ttl_days is absent (UI default / seed = 30).
CACHE_TTL_DAYS=30
HTTP_TIMEOUT_SECONDS=10
PLAYWRIGHT_TIMEOUT_SECONDS=20
RESEARCH_TIMEOUT_SECONDS=120
APP_API_KEY=
LOG_LEVEL=INFO
SCORING_MODEL=v2
# Optional. When set, /api/gpt/* requires Bearer or X-API-Key.
# PROFESSIONAL_PROFILE_API_KEY=
# Comma-separated origins for Open WebUI User Tool Servers (browser → PPA).
# CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
