# Copy to llm-tools/tool-openwebui/.env and fill in values.
# Compose reads this file when you run from this directory, or when you pass
# `--env-file llm-tools/tool-openwebui/.env` from the repo root.
#
# Mode A — remote GPU Ollama (default):
GPU_SERVER_IP=x.x.x.x
OLLAMA_BASE_URL=http://gpu-server-01:11434
#
# Mode B — Ollama on the Mac / Docker host instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# (GPU_SERVER_IP not required for chat models in that case)

OPEN_WEBUI_PORT=3000
# PPA on the host — use this as OpenAPI tool Server URL inside Open WebUI:
PPA_BASE_URL=http://host.docker.internal:8000

# Optional alias for GPU_SERVER_IP (compose falls back to this if GPU_SERVER_IP unset):
# OLLAMA_HOST_IP=x.x.x.x
