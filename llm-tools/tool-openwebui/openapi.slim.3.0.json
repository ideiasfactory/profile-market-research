      "CompensationResearchRequest": {
        "type": "object",
        "required": [
          "profile"
        ],
        "description": "Body for compensation research. Field names are exact:\nuse `profile` (not title/job), `target_contract` (not contractType/jobType),\nand `location` as an object (not a string).\n",
        "properties": {
          "profile": {
            "type": "string",
            "minLength": 3,
            "description": "Required role / profile title for market research.\nExample: \"Arquiteto OIC\". Do not use keys named title, job, or jobTitle.\n"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seniority": {
            "type": "string"
          },
          "allocation_model": {
            "type": "string",
            "enum": [
              "onsite",
              "hybrid",
              "remote"
            ],
            "default": "remote"
          },
          "location": {
            "$ref": "#/components/schemas/CompensationLocation"
          },
          "target_contract": {
            "type": "string",
            "enum": [
              "CLT",
              "PJ"
            ],
            "default": "PJ",
            "description": "Contract type. Use PJ or CLT — not jobType/contractType."
          },
          "providers": {
            "type": "object",
            "nullable": true,
            "properties": {
              "search_engines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "crawlers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "force_refresh": {
            "type": "boolean",
            "default": false,
            "description": "DEFAULT false — use compensation cache when available.\nSet true ONLY when the user explicitly asks to ignore cache / force a new research\n(e.g. \"ignore o cache\", \"ignore cache\", \"force refresh\", \"force uma nova pesquisa\",\n\"forçar nova pesquisa\", \"não use o cache\", \"sem cache\", \"pesquisa nova obrigatória\").\nDo not set true by default or \"to be thorough\".\n"
          },
          "source_job_id": {
            "type": "string",
            "nullable": true,
            "description": "Optional link to a stored job id"
          }
        }
      },
